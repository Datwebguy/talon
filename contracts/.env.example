# Local deployment/operator-only file. Keep real keys off Vercel and out of git.
BASE_RPC_URL=https://mainnet.base.org
# Used only once to deploy the factory and configure the separate operator.
DEPLOYER_PRIVATE_KEY=0x
# Public wallet authorized by the factory owner to approve eligible wallets.
ELIGIBILITY_OPERATOR_ADDRESS=0x
# Used only by script/set_eligible_operator.mjs. Must match the address above.
ELIGIBILITY_OPERATOR_PRIVATE_KEY=0x
# Factory address after deploy_live.mjs completes.
FACTORY_ADDRESS=0x
# Non-US test account to approve. Do not use a real customer wallet for verification.
ELIGIBILITY_ACCOUNT=0x
# Test flow only: account holding AAPLc, plus a separately eligible gift recipient.
TEST_WALLET_PRIVATE_KEY=0x
GIFT_RECIPIENT_ADDRESS=0x
# Raw units only. The verifier tears 2x this amount, gifts one Clip amount, then recombines one pair.
LIVE_FLOW_RAW_AMOUNT=
